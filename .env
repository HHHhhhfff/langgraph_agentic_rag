# -------------------------------
# Qdrant
# -------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=agentic_rag_docs
QDRANT_DISTANCE=cosine
QDRANT_RECREATE_COLLECTION=false
QDRANT_TIMEOUT_SEC=30

# -------------------------------
# Embedding (OpenAI-Compatible)
# 示例模型:
# - text-embedding-3-small
# - qwen3-vl-embedding / Qwen3-VL-Embedding
# 注意向量化的维度要和Odrant向量维度一致
# -------------------------------
EMBEDDING_BASE_URL=https://apirouter.ai/v1
EMBEDDING_API_KEY=sk-FZpMSGbCPNSaWBqELeiZBmXFgaeOliCG4Jls7w1cvoemYYtl
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=   
EMBEDDING_BATCH_SIZE=16
EMBEDDING_TIMEOUT_SEC=60
EMBEDDING_MAX_RETRIES=3
EMBEDDING_INPUT_MAX_TOKENS=8192
EMBEDDING_INPUT_SAFETY_MARGIN_TOKENS=256
VECTOR_MISMATCH_STRATEGY=truncate

# -------------------------------
# Image Embedding (OpenAI-Compatible)
# 示例: qwen3-vl-embedding
# -------------------------------
IMAGE_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_EMBED_API_KEY=sk-091d7d33274942f883976a0997edf507
IMAGE_EMBED_MODEL=qwen3-vl-embedding
IMAGE_EMBED_TIMEOUT_SEC=60
IMAGE_EMBED_MAX_RETRIES=3
IMAGE_EMBED_BATCH_SIZE=8
IMAGE_EMBED_FALLBACK_TO_CAPTION=true
IMAGE_EMBED_REQUIRE_FILE_EXISTS=true

# -------------------------------
# Rerank (OpenAI-Compatible)
# 示例模型:
# - qwen3-rerank / Qwen3-Reranker
# 这里注意rerank模型调用的请求格式
# -------------------------------
RERANK_ENABLED=true
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_API_KEY=sk-091d7d33274942f883976a0997edf507
RERANK_MODEL=qwen3-vl-rerank
RERANK_TOP_N=8
RERANK_TIMEOUT_SEC=30
RERANK_MAX_RETRIES=2

# -------------------------------
# LLM (OpenAI-Compatible)
# -------------------------------
LLM_BASE_URL=https://apirouter.ai/v1
LLM_API_KEY=sk-FZpMSGbCPNSaWBqELeiZBmXFgaeOliCG4Jls7w1cvoemYYtl
LLM_MODEL=gpt-5.4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SEC=90
LLM_MAX_RETRIES=2

# -------------------------------
# Ingestion 引擎切换
# legacy: 原有文本管线
# multimodal: 多模态管线
# -------------------------------
INGESTION_ENGINE=multimodal
MULTIMODAL_ENABLED=true

# PDF 主解析器: llamaparse|unstructured
PDF_PARSER=unstructured

# 文本切块策略: sentence|markdown|hierarchical
# Hierarchical Node Parser --> 按段落结构chunk切块，支持“粗检索 + 精检索”
# SentenceSplitter（LlamaIndex）--> 按语义，进行文本chunk切分
# MarkdownNodeParser --> 按标题(H1~H6)进行chunk切块，适合: 技术文档，wiki，知识库等
TEXT_CHUNK_PARSER=sentence

# Llama Cloud API Key（LlamaParse） #需要到LlamaIndex官方注册API Key才能使用
# 依赖安装: 
# pip install llama-index llama-parse
# pip install llama-index-embeddings-openai
# 准备API Key(去官网注册):
# https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=

# LlamaParse 失败时是否回退 Unstructured
LLAMAPARSE_FALLBACK_TO_UNSTRUCTURED=true

# Unstructured 解析策略: fast|hi_res|auto
UNSTRUCTURED_STRATEGY=auto

# 图片处理
# caption_text: 不调用图像向量接口，直接走文本 embedding（保留兼容行为）。
# direct: 调用图像向量接口
ENABLE_IMAGE_CAPTION=true
IMAGE_EMBED_MODE=direct

# 多模态 ingestion 运行参数
INGESTION_TIMEOUT_SEC=120
INGESTION_MAX_RETRIES=2
INGESTION_BATCH_SIZE=32

# -------------------------------
# MinerU (optional multimodal parser)
# MINERU_BASE_URL=https://mineru.net 即可，不需要再加/api/v4/file-urls/batch
# -------------------------------
ENABLE_MINERU=true
MINERU_MODE=precise
MINERU_BASE_URL=https://mineru.net
MINERU_API_TOKEN=eyJ0eXBlIjoiSldUIiwiYWxnIjoiSFM1MTIifQ.eyJqdGkiOiI2NjMwMDAyMSIsInJvbCI6IlJPTEVfUkVHSVNURVIiLCJpc3MiOiJPcGVuWExhYiIsImlhdCI6MTc3ODQxOTU4MSwiY2xpZW50SWQiOiJsa3pkeDU3bnZ5MjJqa3BxOXgydyIsInBob25lIjoiIiwib3BlbklkIjpudWxsLCJ1dWlkIjoiNDAwYWRlODgtNDA1MC00MmFjLWFhMDItN2MyYzRiOThjZmRlIiwiZW1haWwiOiIiLCJleHAiOjE3ODYxOTU1ODF9.dKhMPTllCxq2dLn1GRuDQs1ysCehPcMGq-XeP1qmneBhToNkNGvVwW_hpuh44_BKgRjIzODi-65ne9w0LiUmcQ
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL_SEC=3
MINERU_POLL_TIMEOUT_SEC=600
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_IS_OCR=false
MINERU_LANGUAGE=ch
MINERU_PAGE_RANGE=
MINERU_EXTRA_FORMATS=
MINERU_FALLBACK_TO_EXISTING=true



# -------------------------------
# 阶段日志观测（新增）
# ENABLE_STAGE_LOG: 开关，true 时输出结构化阶段日志
# LOG_LEVEL: 日志级别
# LOG_FORMAT: json 或 text
# LOG_FILE_PATH: 日志文件路径；为空则输出到控制台
# LOG_INCLUDE_PAYLOAD_STATS: 是否记录每批次 payload 统计（如 modality 分布）
# LOG_SLOW_STAGE_MS: 超过该耗时阈值(ms)输出慢阶段 warning
# ENABLE_CONSOLE_PROGRESS=true|false`
# - 是否开启控制台实时进度输出（面向人工观察的 text 进度行）。
# CONSOLE_PROGRESS_MIN_INTERVAL_MS=150
# - 控制台进度输出最小间隔（毫秒），用于节流避免刷屏。
# CONSOLE_SHOW_STAGE_DONE=true|false
# - 是否输出每个阶段完成提示（`status=done`）。
# CONSOLE_SHOW_BATCH_PROGRESS=true|false
# - 是否输出 embedding/upsert 等批次进度事件。
# -------------------------------
ENABLE_STAGE_LOG=true
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE_PATH=
LOG_INCLUDE_PAYLOAD_STATS=true
LOG_SLOW_STAGE_MS=2000
ENABLE_CONSOLE_PROGRESS=true
CONSOLE_PROGRESS_MIN_INTERVAL_MS=150
CONSOLE_SHOW_STAGE_DONE=true
CONSOLE_SHOW_BATCH_PROGRESS=true

# -------------------------------
# 通用检索/上下文参数
# -------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=120
CHUNK_MIN_LENGTH=80
RETRIEVAL_TOP_K=12
RETRIEVAL_MIN_SCORE=0.15
RETRIEVAL_FILTER_FALLBACK=true
CONTEXT_TOP_N=6
PROMPT_MAX_CONTEXT_CHARS=12000

# -------------------------------
# 答案策略
# -------------------------------
UNCERTAIN_ANSWER_TEXT=无法根据已检索到的资料确定答案。
REQUIRE_CITATIONS=true

