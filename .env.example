# -------------------------------
# Qdrant
# QDRANT_RECREATE_COLLECTION 是否重建向量数据库
# QDRANT_API_KEY 如果用的本地docker，留空即可
# -------------------------------
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=agentic_rag_docs
QDRANT_DISTANCE=cosine
QDRANT_RECREATE_COLLECTION=true
QDRANT_TIMEOUT_SEC=100

# -------------------------------
# Embedding provider: openai_compatible|dashscope_multimodal
EMBEDDING_PROVIDER_TYPE=dashscope_multimodal
IMAGE_EMBED_PROVIDER_TYPE=dashscope_multimodal
DASHSCOPE_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=qwen3-vl-embedding
DASHSCOPE_EMBEDDING_DIMENSION=1024

# Embedding (OpenAI-Compatible)
# 示例模型:
# - text-embedding-3-small
# - qwen3-vl-embedding / Qwen3-VL-Embedding
# 注意向量化的维度要和Odrant向量维度一致
# 注意和图片的嵌入模型要使用同一个多模态嵌入模型，以使得图片和文本在同一个语义空间内。
# -------------------------------
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=qwen3-vl-embedding
EMBEDDING_DIMENSIONS=1024   
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_SEC=120
EMBEDDING_MAX_RETRIES=5
EMBEDDING_INPUT_MAX_TOKENS=8192
EMBEDDING_INPUT_SAFETY_MARGIN_TOKENS=256
VECTOR_MISMATCH_STRATEGY=truncate

# -------------------------------
# Image Embedding (OpenAI-Compatible)
# qwen3-vl-embedding 不走 OpenAI-compatible /embeddings。
# 若使用 dashscope_multimodal，可忽略 EMBEDDING_BASE_URL / IMAGE_EMBED_BASE_URL。

# 示例: qwen3-vl-embedding
# -------------------------------
IMAGE_EMBED_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_EMBED_API_KEY=
IMAGE_EMBED_MODEL=qwen3-vl-embedding
IMAGE_EMBED_TIMEOUT_SEC=60
IMAGE_EMBED_MAX_RETRIES=3
IMAGE_EMBED_BATCH_SIZE=8
IMAGE_EMBED_FALLBACK_TO_CAPTION=true
IMAGE_EMBED_REQUIRE_FILE_EXISTS=true

# -------------------------------
# Rerank (OpenAI-Compatible)
# 示例模型:
# - qwen3-rerank / Qwen3-Reranker
# 这里注意rerank模型调用的请求格式
# -------------------------------
RERANK_ENABLED=true
RERANK_PROVIDER=dashscope
RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
RERANK_API_KEY=
RERANK_MODEL=qwen3-vl-rerank
RERANK_TOP_N=10
RERANK_TIMEOUT_SEC=300
RERANK_MAX_RETRIES=2
RERANK_RETURN_DOCUMENTS=true
RERANK_ENABLE_MULTIMODAL=true
RERANK_INSTRUCT=Given a web search query, retrieve relevant passages that answer the query.

# -------------------------------
# LLM (OpenAI-Compatible)
# -------------------------------
LLM_BASE_URL=https://api.asxs.top/v1
LLM_API_KEY=
LLM_MODEL=gpt-5.4
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=700
LLM_TIMEOUT_SEC=90
LLM_MAX_RETRIES=2

# -------------------------------
# Ingestion 引擎切换
# legacy: 原有文本管线
# multimodal: 多模态管线
# -------------------------------
INGESTION_ENGINE=multimodal
MULTIMODAL_ENABLED=true

# PDF 主解析器: llamaparse|unstructured
PDF_PARSER=unstructured

# 文本切块策略: sentence|markdown|hierarchical
# Hierarchical Node Parser --> 按段落结构chunk切块，支持“粗检索 + 精检索”
# SentenceSplitter（LlamaIndex）--> 按语义，进行文本chunk切分
# MarkdownNodeParser --> 按标题(H1~H6)进行chunk切块，适合: 技术文档，wiki，知识库等
TEXT_CHUNK_PARSER=sentence

# Llama Cloud API Key（LlamaParse） #需要到LlamaIndex官方注册API Key才能使用
# 依赖安装: 
# pip install llama-index llama-parse
# pip install llama-index-embeddings-openai
# 准备API Key(去官网注册):
# https://cloud.llamaindex.ai/
LLAMA_CLOUD_API_KEY=

# LlamaParse 失败时是否回退 Unstructured
LLAMAPARSE_FALLBACK_TO_UNSTRUCTURED=true

# Unstructured 解析策略: fast|hi_res|auto
UNSTRUCTURED_STRATEGY=auto

# 图片处理
# caption_text: 不调用图像向量接口，直接走文本 embedding（保留兼容行为）。
# direct: 调用图像向量接口
ENABLE_IMAGE_CAPTION=true
IMAGE_EMBED_MODE=direct
IMAGE_ENRICHMENT_ENABLED=true
IMAGE_MINERU_ENRICH_ENABLED=true
IMAGE_VLM_CAPTION_ENABLED=true
IMAGE_VLM_PROVIDER=openai_compatible
IMAGE_VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
IMAGE_VLM_DASHSCOPE_API_URL=https://dashscope.aliyuncs.com/api/v1
IMAGE_VLM_API_KEY=
IMAGE_VLM_MODEL=qwen3-vl-flash
IMAGE_VLM_TIMEOUT_SEC=300
IMAGE_VLM_MAX_RETRIES=2
IMAGE_VLM_ENABLE_THINKING=true
IMAGE_OBJECT_MAX_ITEMS=12
IMAGE_CAPTION_MAX_CHARS=1200
IMAGE_OCR_MAX_CHARS=4000

# 多模态 ingestion 运行参数
INGESTION_TIMEOUT_SEC=300
INGESTION_MAX_RETRIES=2
INGESTION_BATCH_SIZE=32
INGESTION_INSPECT_OUTPUT_DIR=storage/ingestion_visualization
INGESTION_INSPECT_MAX_TEXT_CHARS=4000
INGESTION_INSPECT_INCLUDE_MINERU_RAW=true
INGESTION_INSPECT_RENDER_PDF_PAGES=true
INGESTION_INSPECT_INCLUDE_EMBEDDING_PREVIEW=true
INGESTION_INSPECT_INCLUDE_FULL_VECTORS=false
INGESTION_INSPECT_WRITE_QDRANT=true
INGESTION_INSPECT_WRITE_LOCAL_INDEX=true
INGESTION_INSPECT_RECREATE_COLLECTION=true
INGESTION_INSPECT_SYNC_BUILD_INDEX_LOGS=true

# -------------------------------
# MinerU (optional multimodal parser)
# MINERU_BASE_URL=https://mineru.net 即可，不需要再加/api/v4/file-urls/batch
# -------------------------------
ENABLE_MINERU=true
MINERU_MODE=precise
MINERU_BASE_URL=https://mineru.net
MINERU_API_TOKEN=
MINERU_MODEL_VERSION=vlm
MINERU_POLL_INTERVAL_SEC=3
MINERU_POLL_TIMEOUT_SEC=1500
MINERU_POLL_WAIT_FOREVER=false
MINERU_DOWNLOAD_WAIT_FOREVER=false
MINERU_DOWNLOAD_MAX_RETRIES=3
MINERU_DOWNLOAD_RETRY_INTERVAL_SEC=10
MINERU_ENABLE_TABLE=true
MINERU_ENABLE_FORMULA=true
MINERU_TABLE_STRUCTURED_FIRST=true
MINERU_TABLE_MARKDOWN_FALLBACK=true
MINERU_TABLE_SECOND_PASS_ENABLED=false
MINERU_STRUCTURED_TABLE_COALESCE_ENABLED=true
MINERU_STRUCTURED_TABLE_COALESCE_KEEP_CHART=true
MINERU_TABLE_EXACT_CONTENT_COALESCE_ENABLED=true
MINERU_TABLE_EXACT_CONTENT_COALESCE_KEEP_CHART_SEPARATE=false
FORMULA_NODE_MIN_CHARS=8
FORMULA_INLINE_AS_TEXT_ONLY=true
FORMULA_SKIP_INLINE_REFERENCES=true
FORMULA_SKIP_SUPERSCRIPT_NOTES=true
FORMULA_GROUP_DISPLAY_ENABLED=true
FORMULA_GROUP_MAX_GAP_LINES=2
MINERU_IS_OCR=true
MINERU_LANGUAGE=ch
MINERU_PAGE_RANGE=
MINERU_EXTRA_FORMATS=
MINERU_FALLBACK_TO_EXISTING=true
MINERU_CONTEXT_LINK_ENABLED=true
MINERU_CONTEXT_WINDOW_CHARS=800
MINERU_SAME_PAGE_LINK_MAX_NODES=30



# -------------------------------
# 阶段日志观测（新增）
# ENABLE_STAGE_LOG: 开关，true 时输出结构化阶段日志
# LOG_LEVEL: 日志级别
# LOG_FORMAT: json 或 text
# LOG_FILE_PATH: 日志文件路径；为空则输出到控制台
# LOG_INCLUDE_PAYLOAD_STATS: 是否记录每批次 payload 统计（如 modality 分布）
# LOG_SLOW_STAGE_MS: 超过该耗时阈值(ms)输出慢阶段 warning
# ENABLE_CONSOLE_PROGRESS=true|false`
# - 是否开启控制台实时进度输出（面向人工观察的 text 进度行）。
# CONSOLE_PROGRESS_MIN_INTERVAL_MS=150
# - 控制台进度输出最小间隔（毫秒），用于节流避免刷屏。
# CONSOLE_SHOW_STAGE_DONE=true|false
# - 是否输出每个阶段完成提示（`status=done`）。
# CONSOLE_SHOW_BATCH_PROGRESS=true|false
# - 是否输出 embedding/upsert 等批次进度事件。
# -------------------------------
ENABLE_STAGE_LOG=true
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_FILE_PATH=
LOG_INCLUDE_PAYLOAD_STATS=true
LOG_SLOW_STAGE_MS=2000
ENABLE_CONSOLE_PROGRESS=true
CONSOLE_PROGRESS_MIN_INTERVAL_MS=150
CONSOLE_SHOW_STAGE_DONE=true
CONSOLE_SHOW_BATCH_PROGRESS=true

# -------------------------------
# 通用检索/上下文参数
# -------------------------------
CHUNK_SIZE=900
CHUNK_OVERLAP=120
CHUNK_MIN_LENGTH=80
RETRIEVAL_TOP_K=12
RETRIEVAL_MIN_SCORE=0.15
RETRIEVAL_FILTER_FALLBACK=true
RETRIEVAL_INDEX_DIR=storage/retrieval_indexes
RETRIEVAL_INDEX_PERSIST_ENABLED=true
RETRIEVAL_INDEX_FALLBACK_TO_SCROLL=true
REL_EXPAND_EXPLICIT_RELATIONSHIPS=true
REL_EXPAND_SAME_PAGE_RELATIONSHIPS=true

RETRIEVAL_SCORE_VECTOR_WEIGHT=0.45
RETRIEVAL_SCORE_BM25_WEIGHT=0.15
RETRIEVAL_SCORE_RRF_WEIGHT=0.05
RETRIEVAL_SCORE_RERANK_WEIGHT=0.30
RETRIEVAL_SCORE_RELATIONSHIP_WEIGHT=0.75
RETRIEVAL_SCORE_AGENT_RELEVANCE_WEIGHT=0.20
RETRIEVAL_INITIAL_MIN_COMPOSITE_SCORE=0.20
RETRIEVAL_RERANK_MIN_COMPOSITE_SCORE=0.20
RETRIEVAL_FINAL_MIN_COMPOSITE_SCORE=0.20

RETRIEVAL_RERANK_REQUIRE_PRIOR_SCORE=true
RETRIEVAL_RERANK_PRIOR_MIN_COMPOSITE_SCORE=0.25
